{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:ssl": "ng serve --ssl",
    "build": "ng build",
    "build:dev": "ng build --configuration development --source-map",
    "watch": "ng build --watch --configuration development",
    "specgen": "openapi-generator-cli generate -i spec.yml -g typescript-angular -o src/app/generated/commander --global-property models",
    "specgen:auth": "openapi-generator-cli generate -i auth-spec.yml -g typescript-angular -o src/app/generated/auth --global-property models",
    "test": "ng test --browsers=ChromeHeadless_custom --watch=false front"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "~22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "~22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ngneat/elf": "^2.5.1",
    "@ngneat/elf-entities": "^5.0.2",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "@vitest/browser-playwright": "^5.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "~22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@openapitools/openapi-generator-cli": "^2.13.5",
    "@types/jasmine": "~4.3.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "sass-migrator": "^2.6.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
