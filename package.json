{
    "name": "front",
    "version": "1.0.0",
    "packageManager": "npm@11.19.0",
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
        "npm": ">=11"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "start:ssl": "ng serve --ssl",
        "build": "ng build",
        "build:dev": "ng build --configuration development --source-map",
        "watch": "ng build --watch --configuration development",
        "specgen": "openapi-generator-cli generate -i spec.yml -g typescript-angular -o src/app/generated/commander --global-property models",
        "specgen:auth": "openapi-generator-cli generate -i auth-spec.yml -g typescript-angular -o src/app/generated/auth --global-property models",
        "test": "ng test --browsers=ChromeHeadless_custom --watch=false front"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^22.1.0",
        "@angular/cdk": "^22.1.0",
        "@angular/common": "^22.1.0",
        "@angular/compiler": "^22.1.0",
        "@angular/core": "^22.1.0",
        "@angular/forms": "^22.1.0",
        "@angular/material": "^22.1.0",
        "@angular/platform-browser": "^22.1.0",
        "@angular/platform-browser-dynamic": "^22.1.0",
        "@angular/router": "^22.1.0",
        "@ngneat/elf": "^2.5.1",
        "@ngneat/elf-entities": "^5.0.2",
        "@ngx-translate/core": "^18.0.0",
        "@ngx-translate/http-loader": "^18.0.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.0",
        "zone.js": "~0.16.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^22.1.0",
        "@angular/cli": "^22.1.0",
        "@angular/compiler-cli": "^22.1.0",
        "@openapitools/openapi-generator-cli": "^2.41.0",
        "@types/jasmine": "~5.1.0",
        "jasmine-core": "~5.9.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.0",
        "karma-jasmine": "^5.1.0",
        "karma-jasmine-html-reporter": "^2.1.0",
        "typescript": "~6.0.2"
    }
}
